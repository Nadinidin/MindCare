<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/pp2"
        android:scaleType="centerCrop"
        android:contentDescription="Wallpaper MindCare" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#DDE8EDDF"
            app:titleTextColor="#4F6046"
            app:subtitleTextColor="#596548" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#CFFFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp"
            app:strokeColor="#E6FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFragment1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Profil"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/hijau" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFragment2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Tips"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/hijau" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFragment3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Self-Care"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/hijau" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
