<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/pp2"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FAF8E3"
        android:title="Tes Kesehatan Mental"
        android:titleTextColor="#4F6046"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <TextView
        android:id="@+id/txtNomor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Pertanyaan 1 dari 9"
        android:textColor="#596548"
        android:textSize="15sp" />

    <ProgressBar
        android:id="@+id/progressTes"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_margin="20dp"
        android:max="9"
        android:progress="1"
        android:progressTint="#8A8C6B" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selama 2 minggu terakhir, seberapa sering kamu terganggu oleh masalah berikut?"
                android:textColor="#596548"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp" />

            <TextView
                android:id="@+id/txtPertanyaan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="24dp"
                android:text="Pertanyaan akan muncul di sini"
                android:textColor="#4F6046"
                android:textSize="21sp"
                android:textStyle="bold"
                android:lineSpacingExtra="6dp" />

            <RadioGroup
                android:id="@+id/radioGroupJawaban"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/jawaban0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Tidak pernah"
                    android:textColor="#596548"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/jawaban1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Beberapa hari"
                    android:textColor="#596548"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/jawaban2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Lebih dari separuh waktu"
                    android:textColor="#596548"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/jawaban3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Hampir setiap hari"
                    android:textColor="#596548"
                    android:textSize="16sp" />

            </RadioGroup>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSebelumnya"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Sebelumnya"
            android:textAllCaps="false"
            android:textColor="#4F6046"
            app:backgroundTint="#E5E8D8"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBerikutnya"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Berikutnya"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="#8A8C6B"
            app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>
