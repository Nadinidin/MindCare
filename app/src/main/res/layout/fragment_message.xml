<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pp2"
    tools:context=".Message.MessageFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#DDE8EDDF"
        android:theme="@style/ThemeOverlay.AppCompat.Light"
        android:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/kuning"
            app:title="Konsultasi"
            app:subtitle="Layanan kesehatan mental"
            app:titleTextColor="@color/black"
            app:subtitleTextColor="@color/black"
            app:layout_scrollFlags="scroll|enterAlways" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabKonsultasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/kuning"
            app:tabIndicatorColor="#8A8C6B"
            app:tabSelectedTextColor="#8A8C6B"
            app:tabTextColor="#666666"
            app:tabIndicatorFullWidth="true"
            app:tabMode="fixed"
            app:tabGravity="fill" />

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_wave" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMessageItems"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:background="@android:color/transparent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_message" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabTambahKonsultasi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Tambah tenaga profesional"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/kuning"
        app:tint="@color/black" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
