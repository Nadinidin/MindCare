<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home.HomeFragment">

    <!-- WALLPAPER -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Wallpaper MindCare"
        android:scaleType="centerCrop"
        android:src="@drawable/pp2" />

    <!-- KONTEN HOME -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="32dp">

            <!-- WELCOME CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#BFFFFFFF"
                app:cardCornerRadius="26dp"
                app:cardElevation="5dp"
                app:strokeColor="#E6FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font1"
                            android:text="Selamat Datang!"
                            android:textColor="#4F6046"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:fontFamily="@font/font1"
                            android:lineSpacingExtra="4dp"
                            android:text="Halo! Yuk, jaga kesehatan mentalmu hari ini."
                            android:textColor="#596548"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="Logo MindCare"
                        android:src="@drawable/logoapp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- RUANG AMAN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#CCF8F6E1"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:strokeColor="#CCFFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font1"
                        android:text="Ruang Aman untuk Dirimu"
                        android:textColor="#4F6046"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/font1"
                        android:lineSpacingExtra="4dp"
                        android:text="Tidak apa-apa beristirahat sejenak. Kesehatan mentalmu sama pentingnya dengan kesehatan fisik."
                        android:textColor="#596548"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TENAGA PROFESIONAL -->

            <!-- TENAGA PROFESIONAL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/font1"
                android:text="Kenali Tenaga Profesional"
                android:textColor="#4F6046"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#BFFFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="5dp"
                app:strokeColor="#E6FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/txtJudulFitur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font1"
                        android:text="Pilih informasi yang ingin kamu ketahui"
                        android:textColor="#4F6046"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.gridlayout.widget.GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:columnCount="2"
                        app:alignmentMode="alignMargins"
                        app:useDefaultMargins="false">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            app:layout_columnWeight="1"
                            app:cardBackgroundColor="#DDF8F6E1"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <ImageView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:contentDescription="Ikon psikiater"
                                    android:src="@android:drawable/ic_menu_info_details"
                                    app:tint="@color/hijau" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSnackBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:minHeight="48dp"
                                    android:text="Psikiater"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="13sp"
                                    app:backgroundTint="@color/hijau"
                                    app:cornerRadius="12dp" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- PSIKOLOG -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            app:layout_column="1"
                            app:layout_columnWeight="1"
                            app:layout_gravity="fill"
                            app:cardBackgroundColor="#DDF8F6E1"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <ImageView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:contentDescription="Ikon psikolog"
                                    android:src="@android:drawable/ic_menu_myplaces"
                                    app:tint="@color/hijau" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnPsikolog"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:minHeight="48dp"
                                    android:text="Psikolog"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="13sp"
                                    app:backgroundTint="@color/hijau"
                                    app:cornerRadius="12dp" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </androidx.gridlayout.widget.GridLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>



            <!-- AMBIL TES KESEHATAN MENTAL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/font1"
                android:text="Ambil Tes Kesehatan Mental"
                android:textColor="#4F6046"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/font1"
                android:text="Pemeriksaan awal. Kenali kondisi dirimu."
                android:textColor="#596548"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- TES KESEHATAN MENTAL -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="230dp"
                        android:layout_height="360dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="115dp"
                                android:background="#EAEAF8"
                                android:gravity="center"
                                android:text="🧠"
                                android:textSize="65sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="14dp"
                                android:fontFamily="@font/font1"
                                android:gravity="center_vertical"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:text="Tes Kesehatan Mental"
                                android:textColor="#333333"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/font1"
                                android:gravity="top"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:text="Kenali kondisi dan kesejahteraan mentalmu."
                                android:textColor="#666666"
                                android:textSize="13sp" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTesMental"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:minHeight="0dp"
                                android:text="Ambil Tes"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                app:backgroundTint="@color/hijau"
                                app:cornerRadius="10dp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- TES PERAWATAN DIRI -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="230dp"
                        android:layout_height="360dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="115dp"
                                android:background="#F8EAF0"
                                android:gravity="center"
                                android:text="🌷"
                                android:textSize="65sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="14dp"
                                android:fontFamily="@font/font1"
                                android:gravity="center_vertical"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:text="Tes Perawatan Diri"
                                android:textColor="#333333"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/font1"
                                android:gravity="top"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:text="Kenali kebiasaan dalam merawat dirimu."
                                android:textColor="#666666"
                                android:textSize="13sp" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTesPerawatan"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:minHeight="0dp"
                                android:text="Ambil Tes"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                app:backgroundTint="@color/hijau"
                                app:cornerRadius="10dp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- TES STRES -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="230dp"
                        android:layout_height="360dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="115dp"
                                android:background="#F8F0E5"
                                android:gravity="center"
                                android:text="🌿"
                                android:textSize="65sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="14dp"
                                android:fontFamily="@font/font1"
                                android:gravity="center_vertical"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:text="Tes Tingkat Stres"
                                android:textColor="#333333"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/font1"
                                android:gravity="top"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:text="Kenali tingkat stres yang kamu alami."
                                android:textColor="#666666"
                                android:textSize="13sp" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTesStres"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:minHeight="0dp"
                                android:text="Ambil Tes"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                app:backgroundTint="@color/hijau"
                                app:cornerRadius="10dp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- TES KECEMASAN -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="230dp"
                        android:layout_height="360dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="115dp"
                                android:background="#E8EFFB"
                                android:gravity="center"
                                android:text="💜"
                                android:textSize="65sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="14dp"
                                android:fontFamily="@font/font1"
                                android:gravity="center_vertical"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:text="Tes Gangguan Kecemasan"
                                android:textColor="#333333"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/font1"
                                android:gravity="top"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:text="Kenali gejala kecemasan yang dirasakan."
                                android:textColor="#666666"
                                android:textSize="13sp" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTesKecemasan"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:minHeight="0dp"
                                android:text="Ambil Tes"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                app:backgroundTint="@color/hijau"
                                app:cornerRadius="10dp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- TES REMAJA -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="230dp"
                        android:layout_height="360dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="115dp"
                                android:background="#F2EAF8"
                                android:gravity="center"
                                android:text="🌻"
                                android:textSize="65sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="14dp"
                                android:fontFamily="@font/font1"
                                android:gravity="center_vertical"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:text="Tes Kesehatan Mental Remaja"
                                android:textColor="#333333"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/font1"
                                android:gravity="top"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:text="Kenali kondisi emosional pada masa remaja."
                                android:textColor="#666666"
                                android:textSize="13sp" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTesRemaja"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:minHeight="0dp"
                                android:text="Ambil Tes"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                app:backgroundTint="@color/hijau"
                                app:cornerRadius="10dp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>
            <!-- AKHIR AMBIL TES KESEHATAN MENTAL -->




            <!-- JELAJAHI MINDCARE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/font1"
                android:text="Jelajahi MindCare"
                android:textColor="#4F6046"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- ARTIKEL -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#BFFFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="#E6FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="Ikon artikel"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="@color/hijau" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnArtikel"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Artikel Kesehatan Mental"
                        android:textAllCaps="false"
                        android:textColor="#4F6046"
                        app:backgroundTint="#DDF8F6E1"
                        app:cornerRadius="14dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#BFFFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="#E6FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="Ikon tentang MindCare"
                        android:src="@android:drawable/ic_menu_help"
                        app:tint="@color/hijau" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToLima"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Tentang MindCare"
                        android:textAllCaps="false"
                        android:textColor="#4F6046"
                        app:backgroundTint="#DDF8F6E1"
                        app:cornerRadius="14dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#BFFFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="#E6FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="Ikon Ruang Sehat"
                        android:src="@android:drawable/ic_menu_compass"
                        app:tint="@color/hijau" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSixth"
                        android:layout_width="0dp"
