<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/pp2"
        android:scaleType="centerCrop"
        android:contentDescription="Wallpaper MindCare" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MINDCARE  /  EMOTIONAL WELLNESS"
                android:textColor="#71815D"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/font1"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Apa yang Kamu Rasakan Hari Ini?"
                android:textColor="#4F6046"
                android:textSize="27sp"
                android:textStyle="bold"
                android:fontFamily="@font/font1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Yuk, kenali perasaanmu. Semua emosi adalah bagian alami dari diri kita."
                android:textColor="#596548"
                android:textSize="14sp"
                android:fontFamily="@font/font1"
                android:lineSpacingExtra="4dp" />

            <!-- Emotion Grid Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Kenali Jenis Emosi"
                android:textColor="#4F6046"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="@font/font1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Setiap emosi memiliki pesan yang berbeda."
                android:textColor="#596548"
                android:textSize="13sp"
                android:fontFamily="@font/font1" />

            <!-- Grid Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Senang -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="155dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    app:cardBackgroundColor="#CCF8F6E1"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😊"
                            android:textSize="38sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Senang"
                            android:textColor="#4F6046"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Saat merasa bahagia dan puas."
                            android:textColor="#596548"
                            android:textSize="12sp"
                            android:fontFamily="@font/font1" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sedih -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="155dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    app:cardBackgroundColor="#CFFFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😢"
                            android:textSize="38sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Sedih"
                            android:textColor="#4F6046"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Saat mengalami kehilangan atau kecewa."
                            android:textColor="#596548"
                            android:textSize="12sp"
                            android:fontFamily="@font/font1" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Grid Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Marah -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="155dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    app:cardBackgroundColor="#CFFFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😠"
                            android:textSize="38sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Marah"
                            android:textColor="#4F6046"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Saat merasa terganggu atau diperlakukan tidak adil."
                            android:textColor="#596548"
                            android:textSize="12sp"
                            android:fontFamily="@font/font1" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cemas -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="155dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    app:cardBackgroundColor="#CCF8F6E1"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="😟"
                            android:textSize="38sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Cemas"
                            android:textColor="#4F6046"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Saat khawatir menghadapi sesuatu."
                            android:textColor="#596548"
                            android:textSize="12sp"
                            android:fontFamily="@font/font1" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- How to understand emotions -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                app:cardBackgroundColor="#CFFFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:strokeColor="#E6FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Belajar Memahami Emosi"
                        android:textColor="#4F6046"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font1" />

                    <!-- Step 1 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="01  Berhenti Sejenak"
                        android:textColor="#71815D"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Luangkan waktu untuk memperhatikan apa yang sedang kamu rasakan."
                        android:textColor="#596548"
                        android:textSize="13sp"
                        android:fontFamily="@font/font1" />

                    <!-- Step 2 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="#668A8C6B" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="02  Cari Tahu Penyebabnya"
                        android:textColor="#71815D"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Pikirkan kejadian atau situasi yang mungkin memicu perasaan tersebut."
                        android:textColor="#596548"
                        android:textSize="13sp"
                        android:fontFamily="@font/font1" />

                    <!-- Step 3 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="#668A8C6B" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="03  Pilih Respons yang Sehat"
                        android:textColor="#71815D"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Ambil napas, bercerita kepada orang terpercaya, atau lakukan kegiatan yang membuatmu nyaman."
                        android:textColor="#596548"
                        android:textSize="13sp"
                        android:fontFamily="@font/font1" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Closing -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Tidak apa-apa merasakan semuanya. Beri dirimu waktu. ♡"
                android:textColor="#4F6046"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/font1" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>
