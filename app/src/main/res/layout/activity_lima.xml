<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pertemuan5.LimaActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Wallpaper MindCare"
        android:scaleType="centerCrop"
        android:src="@drawable/pp2" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#DDE8EDDF"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Tentang Kami"
            app:titleTextColor="#4F6046">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:contentDescription="Logo MindCare"
                android:src="@drawable/logoapp" />

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#BFFFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="5dp"
                app:strokeColor="#E6FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="26dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        app:cardBackgroundColor="#CFFFFFFF"
                        app:cardCornerRadius="56dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#EEFFFFFF"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Logo MindCare"
                            android:padding="15dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/logoapp" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/font1"
                        android:gravity="center"
                        android:text="MindCare"
                        android:textColor="#4F6046"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/font1"
                        android:gravity="center"
                        android:text="Your Mind Matters"
                        android:textColor="#596548"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="52dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/hijau" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/font1"
                        android:gravity="center"
                        android:lineSpacingExtra="5dp"
                        android:text="Informasi dan edukasi untuk kesehatan mental serta kesejahteraan diri."
                        android:textColor="#596548"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#CFFFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:strokeColor="#E6FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font1"
                        android:text="Apa itu MindCare?"
                        android:textColor="#4F6046"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/font1"
                        android:lineSpacingExtra="5dp"
                        android:text="MindCare adalah aplikasi yang membantu pengguna mengenal kesehatan mental, memahami perasaan, dan mengakses informasi dasar tentang kesejahteraan diri."
                        android:textColor="#596548"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#CCF8F6E1"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:strokeColor="#E6FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font1"
                        android:text="Tujuan Kami"
                        android:textColor="#4F6046"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/font1"
                        android:lineSpacingExtra="5dp"
                        android:text="Meningkatkan kesadaran mengenai pentingnya kesehatan mental dan mendorong pengguna untuk lebih peduli terhadap kondisi emosionalnya."
                        android:textColor="#596548"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#CFFFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:strokeColor="#E6FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font1"
                        android:text="Layanan dan Informasi"
                        android:textColor="#4F6046"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/font1"
                        android:lineSpacingExtra="9dp"
                        android:text="• Informasi kesehatan mental&#10;• Pengenalan psikiater dan psikolog&#10;• Artikel edukasi kesehatan mental&#10;• Edukasi tentang perawatan diri"
                        android:textColor="#596548"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#DDF8F6E1"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="#E6FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="17dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Informasi penting"
                        android:src="@android:drawable/ic_dialog_info"
                        app:tint="@color/hijau" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/font1"
                        android:lineSpacingExtra="4dp"
                        android:text="MindCare menyediakan informasi edukatif dan tidak menggantikan diagnosis atau penanganan tenaga profesional."
                        android:textColor="#4F6046"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/font1"
                android:gravity="center"
                android:text="MindCare • Your Mind Matters"
                android:textColor="#4F6046"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
