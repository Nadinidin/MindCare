<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8E3"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#FAF8E3"
            app:title="Tes Perawatan Diri"
            app:titleTextColor="#4F6046"
            app:navigationIcon="@drawable/ic_arrow_back" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/pp2"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:background="#F2EAF8"
                    android:gravity="center"
                    android:text="🌷"
                    android:textSize="100sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/font1"
                    android:text="Tes Perawatan Diri"
                    android:textColor="#4F6046"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/font1"
                    android:text="Kenali seberapa baik kamu menjaga kesehatan fisik, emosional, dan kebutuhan diri dalam kehidupan sehari-hari."
                    android:textColor="#596548"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tentang Tes"
                            android:textColor="#4F6046"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Tes ini berisi pertanyaan refleksi mengenai kebiasaan menjaga diri, seperti istirahat, pola makan, kebersihan, aktivitas fisik, dan pengelolaan emosi."
                            android:textColor="#596548"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Informasi Tes"
                            android:textColor="#4F6046"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font1" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="• Jumlah pertanyaan: 10\n• Pilihan jawaban: 4 pilihan\n• Waktu pengerjaan: sekitar 3–5 menit"
                            android:textColor="#596548"
                            android:textSize="14sp"
                            android:lineSpacingExtra="5dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/font1"
                    android:text="Catatan: Tes ini merupakan evaluasi mandiri untuk refleksi kebiasaan perawatan diri, bukan alat diagnosis medis."
                    android:textColor="#8A654B"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMulaiTesPerawatan"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_margin="18dp"
            android:text="Mulai Tes"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            app:backgroundTint="#8A8C6B"
            app:cornerRadius="14dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
