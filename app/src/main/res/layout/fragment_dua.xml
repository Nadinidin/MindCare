<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Wallpaper MindCare -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/pp2"
        android:contentDescription="Wallpaper MindCare" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Judul halaman tanpa header card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MINDCARE  /  SELF-CARE"
                android:textColor="#7C8466"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="@font/font1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Waktunya Merawat Diri"
                android:textColor="#4F6046"
                android:textSize="27sp"
                android:textStyle="bold"
                android:fontFamily="@font/font1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="22dp"
                android:text="Hal sederhana yang kamu lakukan hari ini juga berarti untuk dirimu."
                android:textColor="#596548"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="@font/font1" />

            <!-- Motivasi singkat -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#CCF8F6E1"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeColor="#E6FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="♡  REMINDER FOR YOU"
                        android:textColor="#7C8466"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Kamu juga pantas mendapatkan perhatian dan kasih sayang dari dirimu sendiri."
                        android:textColor="#4F6046"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="5dp"
                        android:fontFamily="@font/font1" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Judul aktivitas -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Rutinitas Kecil Hari Ini"
                android:textColor="#4F6046"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="@font/font1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="14dp"
                android:text="Pilih waktu yang nyaman untuk dirimu."
                android:textColor="#596548"
                android:textSize="13sp"
                android:fontFamily="@font/font1" />

            <!-- Satu card berisi daftar aktivitas -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#DFFFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeColor="#E6FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Aktivitas pagi -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:text="🌿"
                            android:textSize="25sp"
                            android:background="#EAF0DE" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PAGI"
                                android:textColor="#89916E"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Latihan Pernapasan"
                                android:textColor="#4F6046"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/font1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Ambil napas perlahan dan tenangkan pikiran."
                                android:textColor="#596548"
                                android:textSize="12sp"
                                android:fontFamily="@font/font1" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#DDE2D1" />

                    <!-- Aktivitas siang -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="14dp">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:text="📖"
                            android:textSize="25sp"
                            android:background="#F8F0DF" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SIANG"
                                android:textColor="#89916E"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Menulis Jurnal Harian"
                                android:textColor="#4F6046"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/font1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Tuliskan perasaan dan hal yang kamu syukuri."
                                android:textColor="#596548"
                                android:textSize="12sp"
                                android:fontFamily="@font/font1" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#DDE2D1" />

                    <!-- Aktivitas sore -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="14dp">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:text="🌤️"
                            android:textSize="25sp"
                            android:background="#F4E8EA" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SORE"
                                android:textColor="#89916E"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Istirahat dari Layar"
                                android:textColor="#4F6046"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/font1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Jauhkan ponsel sejenak dan nikmati sekitar."
                                android:textColor="#596548"
                                android:textSize="12sp"
                                android:fontFamily="@font/font1" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#DDE2D1" />

                    <!-- Aktivitas malam -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="14dp">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:text="🌙"
                            android:textSize="25sp"
                            android:background="#EAE8F2" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MALAM"
                                android:textColor="#89916E"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Lakukan Hal Menyenangkan"
                                android:textColor="#4F6046"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/font1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Nikmati hobi atau dengarkan musik favorit."
                                android:textColor="#596548"
                                android:textSize="12sp"
                                android:fontFamily="@font/font1" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Penutup -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Mulai dari hal kecil, lakukan dengan penuh kasih. ♡"
                android:textColor="#596548"
                android:textSize="13sp"
                android:textStyle="italic"
                android:fontFamily="@font/font1" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>
